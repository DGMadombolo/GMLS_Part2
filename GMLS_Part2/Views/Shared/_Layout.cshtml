<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - SmartContract Hub
    </title>

    <script type="importmap"></script>

    <!-- ================================================= -->
    <!-- BOOTSTRAP -->
    <!-- ================================================= -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ================================================= -->
    <!-- SITE CSS -->
    <!-- ================================================= -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/GMLS_Part2.styles.css"
          asp-append-version="true" />

</head>

<body class="bg-light d-flex flex-column min-vh-100">

    <!-- ================================================= -->
    <!-- NAVBAR -->
    <!-- ================================================= -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

            <div class="container-fluid">

                <!-- BRAND -->

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    SmartContract Hub

                </a>

                <!-- MOBILE TOGGLER -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon">
                    </span>

                </button>

                <!-- NAVIGATION LINKS -->

                <div class="collapse navbar-collapse"
                     id="navbarContent">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link text-white"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        <!-- CLIENTS -->

                        <li class="nav-item">

                            <a class="nav-link text-white"
                               asp-controller="Clients"
                               asp-action="Index">

                                Clients

                            </a>

                        </li>

                        <!-- CONTRACTS -->

                        <li class="nav-item">

                            <a class="nav-link text-white"
                               asp-controller="Contracts"
                               asp-action="Index">

                                Contracts

                            </a>

                        </li>

                        <!-- SERVICE REQUESTS -->

                        <li class="nav-item">

                            <a class="nav-link text-white"
                               asp-controller="ServiceRequests"
                               asp-action="Index">

                                Service Requests

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <!-- ================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ================================================= -->

    <div class="container mt-4 flex-grow-1">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>

    <!-- ================================================= -->
    <!-- FOOTER -->
    <!-- ================================================= -->

    <footer class="bg-dark text-white shadow-sm mt-auto">

        <div class="container-fluid py-3">

            <div class="text-center">

                <span class="fw-bold">

                    SmartContract Hub

                </span>

                &copy; 2026

                <br />

                <small>

                    Developed by Lucky Mkhatshwa

                </small>

            </div>

        </div>

    </footer>

    <!-- ================================================= -->
    <!-- SCRIPTS -->
    <!-- ================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false)

</body>

</html>