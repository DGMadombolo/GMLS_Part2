<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - SmartContract Hub
    </title>

    <!-- ================================================= -->
    <!-- BOOTSTRAP -->
    <!-- ================================================= -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ================================================= -->
    <!-- BOOTSTRAP ICONS -->
    <!-- ================================================= -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- ================================================= -->
    <!-- SITE CSS -->
    <!-- ================================================= -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/GMLS_Part2.styles.css"
          asp-append-version="true" />

</head>

<body class="d-flex flex-column min-vh-100">

    <!-- ================================================= -->
    <!-- NAVBAR -->
    <!-- ================================================= -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">

            <div class="container-fluid px-4">

                <!-- BRAND -->

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-bar-chart-line-fill fs-4">
                    </i>

                    SmartContract Hub

                </a>

                <!-- MOBILE BUTTON -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon">
                    </span>

                </button>

                <!-- NAVIGATION -->

                <div class="collapse navbar-collapse"
                     id="navbarContent">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-2">

                        <!-- DASHBOARD -->

                        <li class="nav-item">

                            <a class="nav-link fw-semibold text-white"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door-fill me-1">
                                </i>

                                Dashboard

                            </a>

                        </li>

                        <!-- CLIENTS -->

                        <li class="nav-item">

                            <a class="nav-link fw-semibold text-white"
                               asp-controller="Clients"
                               asp-action="Index">

                                <i class="bi bi-people-fill me-1">
                                </i>

                                Clients

                            </a>

                        </li>

                        <!-- CONTRACTS -->

                        <li class="nav-item">

                            <a class="nav-link fw-semibold text-white"
                               asp-controller="Contracts"
                               asp-action="Index">

                                <i class="bi bi-file-earmark-text-fill me-1">
                                </i>

                                Contracts

                            </a>

                        </li>

                        <!-- SERVICE REQUESTS -->

                        <li class="nav-item">

                            <a class="nav-link fw-semibold text-white"
                               asp-controller="ServiceRequests"
                               asp-action="Index">

                                <i class="bi bi-headset me-1">
                                </i>

                                Service Requests

                            </a>

                        </li>

                    </ul>

                    <!-- RIGHT SIDE -->

                    <div class="d-flex align-items-center text-white">

                        <i class="bi bi-person-circle fs-4 me-2">
                        </i>

                        <span class="fw-semibold">

                            Admin Dashboard

                        </span>

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <!-- ================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ================================================= -->

    <main class="flex-grow-1">

        <div class="container-fluid px-4 py-4">

            @RenderBody()

        </div>

    </main>

    <!-- ================================================= -->
    <!-- FOOTER -->
    <!-- ================================================= -->

    <footer class="footer shadow-sm mt-auto">

        <div class="container-fluid py-3">

            <div class="d-flex flex-column flex-md-row
                        justify-content-between
                        align-items-center gap-2">

                <!-- LEFT -->

                <div class="fw-bold text-white">

                    <i class="bi bi-bar-chart-line-fill me-2">
                    </i>

                    SmartContract Hub

                </div>

                <!-- CENTER -->

                <div class="text-white small">

                    © 2026 SmartContract Hub.
                    All Rights Reserved.

                </div>

                <!-- RIGHT -->

                <div class="text-white small">

                    Developed by Lucky Mkhatshwa

                </div>

            </div>

        </div>

    </footer>

    <!-- ================================================= -->
    <!-- SCRIPTS -->
    <!-- ================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false)

</body>

</html>