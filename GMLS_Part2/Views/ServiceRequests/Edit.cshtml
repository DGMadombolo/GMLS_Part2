@model GMLS_Part2.Models.ServiceRequest

@{
    ViewData["Title"] = "Edit Service Request";
}

<div class="container">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-warning">

            <h3 class="mb-0 text-dark">
                Edit Service Request
            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input type="hidden" asp-for="Id" />

                <!-- Contract -->

                <div class="mb-3">

                    <label asp-for="ContractId"
                           class="form-label fw-bold">
                    </label>

                    <select asp-for="ContractId"
                            class="form-select"
                            asp-items="ViewBag.ContractId">

                        <option value="">
                            -- Select Contract --
                        </option>

                    </select>

                    <span asp-validation-for="ContractId"
                          class="text-danger">
                    </span>

                </div>

                <!-- Description -->

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label fw-bold">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <!-- USD Cost -->

                <div class="mb-3">

                    <label asp-for="CostUSD"
                           class="form-label fw-bold">
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            $
                        </span>

                        <input asp-for="CostUSD"
                               class="form-control"
                               placeholder="Enter amount in USD" />

                    </div>

                    <small class="text-muted">
                        ZAR value will be recalculated automatically.
                    </small>

                    <span asp-validation-for="CostUSD"
                          class="text-danger">
                    </span>

                </div>

                <!-- Display Current ZAR -->

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Current Cost (ZAR)
                    </label>

                    <input value="R @Model.CostZAR"
                           class="form-control"
                           readonly />

                </div>

                <!-- Status -->

                <div class="mb-4">

                    <label asp-for="Status"
                           class="form-label fw-bold">
                    </label>

                    <select asp-for="Status"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<GMLS_Part2.Models.RequestStatus>()">
                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger">
                    </span>

                </div>

                <!-- Buttons -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning text-dark">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back to List
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}