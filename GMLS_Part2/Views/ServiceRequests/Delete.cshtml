@model GMLS_Part2.Models.ServiceRequest

@{
    ViewData["Title"] = "Delete Service Request";
}

<div class="container">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-danger text-white">

            <h3 class="mb-0">
                Delete Service Request
            </h3>

        </div>

        <div class="card-body">

            <div class="alert alert-danger">

                <strong>Warning!</strong>

                Are you sure you want to delete this service request?

            </div>

            <dl class="row">

                <!-- Contract -->

                <dt class="col-sm-3 fw-bold">
                    Contract ID
                </dt>

                <dd class="col-sm-9">
                    @Model.Contract.Id
                </dd>

                <!-- Description -->

                <dt class="col-sm-3 fw-bold">
                    Description
                </dt>

                <dd class="col-sm-9">
                    @Model.Description
                </dd>

                <!-- USD -->

                <dt class="col-sm-3 fw-bold">
                    Cost (USD)
                </dt>

                <dd class="col-sm-9">
                    $@Model.CostUSD
                </dd>

                <!-- ZAR -->

                <dt class="col-sm-3 fw-bold">
                    Cost (ZAR)
                </dt>

                <dd class="col-sm-9">
                    R @Model.CostZAR
                </dd>

                <!-- Status -->

                <dt class="col-sm-3 fw-bold">
                    Status
                </dt>

                <dd class="col-sm-9">

                    @if (Model.Status == GMLS_Part2.Models.RequestStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                    else if (Model.Status == GMLS_Part2.Models.RequestStatus.InProgress)
                    {
                        <span class="badge bg-primary">
                            In Progress
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Completed
                        </span>
                    }

                </dd>

            </dl>

            <!-- Buttons -->

            <form asp-action="Delete" class="mt-4">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">
                        Delete Request
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back to List
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>