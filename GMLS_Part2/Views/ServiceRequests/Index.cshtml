@model IEnumerable<GMLS_Part2.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="fw-bold">
        Service Requests
    </h1>

    <a asp-action="Create"
       class="btn btn-warning text-dark">
        + Create Service Request
    </a>

</div>

<!-- ===================================================== -->
<!-- SEARCH / FILTER -->
<!-- ===================================================== -->

<form method="get"
      class="row g-3 mb-4">

    <!-- STATUS -->

    <div class="col-md-4">

        <label class="form-label fw-bold">
            Status
        </label>

        <select name="status"
                class="form-select">

            <option value="">
                All Statuses
            </option>

            @foreach (var status in Enum.GetValues(typeof(GMLS_Part2.Models.RequestStatus)))
            {
                <option value="@status">
                    @status
                </option>
            }

        </select>

    </div>

    <!-- SEARCH DESCRIPTION -->

    <div class="col-md-4">

        <label class="form-label fw-bold">
            Search Description
        </label>

        <input type="text"
               name="searchTerm"
               class="form-control"
               placeholder="Search service request..." />

    </div>

    <!-- BUTTON -->

    <div class="col-md-4 d-flex align-items-end">

        <button type="submit"
                class="btn btn-dark w-100">
            Search / Filter
        </button>

    </div>

</form>

<!-- ===================================================== -->
<!-- TABLE -->
<!-- ===================================================== -->

<table class="table table-bordered table-hover shadow-sm">

    <thead class="table-dark">

        <tr>

            <th>
                Contract ID
            </th>

            <th>
                Description
            </th>

            <th>
                Cost (USD)
            </th>

            <th>
                Cost (ZAR)
            </th>

            <th>
                Status
            </th>

            <th class="text-center">
                Actions
            </th>

        </tr>

    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>

                    <!-- CONTRACT -->

                    <td>
                        @item.ContractId
                    </td>

                    <!-- DESCRIPTION -->

                    <td>
                        @item.Description
                    </td>

                    <!-- USD -->

                    <td>
                        $@item.CostUSD
                    </td>

                    <!-- ZAR -->

                    <td>
                        R @item.CostZAR.ToString("N2")
                    </td>

                    <!-- STATUS -->

                    <td>

                        @if (item.Status == GMLS_Part2.Models.RequestStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (item.Status == GMLS_Part2.Models.RequestStatus.InProgress)
                        {
                            <span class="badge bg-primary">
                                In Progress
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }

                    </td>

                    <!-- ACTIONS -->

                    <td class="text-center">

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-info text-white">
                            Details
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>

                <td colspan="6"
                    class="text-center text-muted">

                    No service requests found.

                </td>

            </tr>
        }

    </tbody>

</table>