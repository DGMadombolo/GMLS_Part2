@model IEnumerable<GMLS_Part2.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="fw-bold">Service Requests</h1>

    <a asp-action="Create"
       class="btn btn-warning text-dark">
        + Create Service Request
    </a>

</div>

<table class="table table-bordered table-hover shadow-sm">

    <thead class="table-dark">

        <tr>

            <th>
                Contract ID
            </th>

            <th>
                Description
            </th>

            <th>
                Cost (USD)
            </th>

            <th>
                Cost (ZAR)
            </th>

            <th>
                Status
            </th>

            <th class="text-center">
                Actions
            </th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.Contract.Id
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>

                <td>
                    $@item.CostUSD
                </td>

                <td>
                    R @item.CostZAR
                </td>

                <td>

                    @if (item.Status == GMLS_Part2.Models.RequestStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                    else if (item.Status == GMLS_Part2.Models.RequestStatus.InProgress)
                    {
                        <span class="badge bg-primary">
                            In Progress
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Completed
                        </span>
                    }

                </td>

                <td class="text-center">

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-info text-white">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>