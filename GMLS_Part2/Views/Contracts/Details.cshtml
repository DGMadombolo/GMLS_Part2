@model GMLS_Part2.Models.Contract

@{
    ViewData["Title"] = "Contract Details";
}

<div class="container">

    <div class="card shadow-lg border-0">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <div class="card-header bg-primary">

            <h3 class="mb-0 text-white">

                Contract Details

            </h3>

        </div>

        <!-- ================================================= -->
        <!-- BODY -->
        <!-- ================================================= -->

        <div class="card-body">

            <dl class="row">

                <!-- CLIENT -->

                <dt class="col-sm-3 fw-bold">

                    Client

                </dt>

                <dd class="col-sm-9">

                    @Model.Client.Name

                </dd>

                <!-- START DATE -->

                <dt class="col-sm-3 fw-bold">

                    Start Date

                </dt>

                <dd class="col-sm-9">

                    @Model.StartDate.ToShortDateString()

                </dd>

                <!-- END DATE -->

                <dt class="col-sm-3 fw-bold">

                    End Date

                </dt>

                <dd class="col-sm-9">

                    @Model.EndDate.ToShortDateString()

                </dd>

                <!-- STATUS -->

                <dt class="col-sm-3 fw-bold">

                    Status

                </dt>

                <dd class="col-sm-9">

                    @if (Model.Status ==
                                        GMLS_Part2.Models.ContractStatus.Active)
                    {
                        <span class="badge bg-success">

                            Active

                        </span>
                    }
                    else if (Model.Status ==
                    GMLS_Part2.Models.ContractStatus.Expired)
                    {
                        <span class="badge bg-danger">

                            Expired

                        </span>
                    }
                    else if (Model.Status ==
                    GMLS_Part2.Models.ContractStatus.OnHold)
                    {
                        <span class="badge bg-warning">

                            On Hold

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">

                            Draft

                        </span>
                    }

                </dd>

                <!-- SERVICE LEVEL -->

                <dt class="col-sm-3 fw-bold">

                    Service Level

                </dt>

                <dd class="col-sm-9">

                    @Model.ServiceLevel

                </dd>

                <!-- PDF FILE -->

                <dt class="col-sm-3 fw-bold">

                    Agreement File

                </dt>

                <dd class="col-sm-9">

                    @if (!string.IsNullOrEmpty(
                                        Model.SignedAgreementPath))
                    {
                        <a asp-action="Download"
                           asp-route-id="@Model.Id"
                           class="btn btn-sm btn-success">

                            Download PDF

                        </a>
                    }
                    else
                    {
                        <span class="text-muted">

                            No File Uploaded

                        </span>
                    }

                </dd>

            </dl>

            <!-- ================================================= -->
            <!-- BUTTONS -->
            <!-- ================================================= -->

            <div class="mt-4 d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model?.Id"
                   class="btn btn-warning">

                    Edit Contract

                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back to List

                </a>

            </div>

        </div>

    </div>

</div>