@model GMLS_Part2.Models.Contract

@{
    ViewData["Title"] = "Create Contract";
}

<div class="container">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-success text-white">
            <h3 class="mb-0">
                Create Contract
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Create"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- Client -->

                <div class="mb-3">

                    <label asp-for="ClientId"
                           class="form-label fw-bold">
                    </label>

                    <select asp-for="ClientId"
                            class="form-select"
                            asp-items="ViewBag.ClientId">

                        <option value="">
                            -- Select Client --
                        </option>

                    </select>

                    <span asp-validation-for="ClientId"
                          class="text-danger">
                    </span>

                </div>

                <!-- Start Date -->

                <div class="mb-3">

                    <label asp-for="StartDate"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="StartDate"
                          class="text-danger">
                    </span>

                </div>

                <!-- End Date -->

                <div class="mb-3">

                    <label asp-for="EndDate"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EndDate"
                          class="text-danger">
                    </span>

                </div>

                <!-- Status -->

                <div class="mb-3">

                    <label asp-for="Status"
                           class="form-label fw-bold">
                    </label>

                    <select asp-for="Status"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<GMLS_Part2.Models.ContractStatus>()">
                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger">
                    </span>

                </div>

                <!-- Service Level -->

                <div class="mb-3">

                    <label asp-for="ServiceLevel"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="ServiceLevel"
                           class="form-control" />

                    <span asp-validation-for="ServiceLevel"
                          class="text-danger">
                    </span>

                </div>

                <!-- PDF Upload -->

                <div class="mb-4">

                    <label asp-for="AgreementFile"
                           class="form-label fw-bold">
                        Upload Signed Agreement (PDF)
                    </label>

                    <input asp-for="AgreementFile"
                           type="file"
                           class="form-control"
                           accept=".pdf" />

                    <span asp-validation-for="AgreementFile"
                          class="text-danger">
                    </span>

                </div>

                <!-- Buttons -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">
                        Save Contract
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back to List
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}