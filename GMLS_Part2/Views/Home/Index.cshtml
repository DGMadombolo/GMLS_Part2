@{
    ViewData["Title"] = "Dashboard";
}

<!-- ================================================= -->
<!-- HERO SECTION -->
<!-- ================================================= -->

<div class="card shadow-lg border-0 mb-5 overflow-hidden">

    <div class="card-body p-5">

        <div class="row align-items-center">

            <!-- LEFT -->

            <div class="col-lg-8">

                <span class="badge px-3 py-2 mb-3"
                      style="background-color:#D2FF28; color:black;">

                    Enterprise Dashboard

                </span>

                <h1 class="display-4 fw-bold mb-3">

                    SmartContract Hub

                </h1>

                <p class="lead text-muted mb-4"
                style="
                    font-size: 1.45rem;
                    line-height: 1.9;
                    max-width: 850px;
                    font-weight: 500;
                    ">

                    Manage contracts, clients, service requests,
                    PDF agreements, and currency conversion from
                    one centralized enterprise platform.

                </p>

                <div class="d-flex flex-wrap gap-3">

                    <a asp-controller="Contracts"
                       asp-action="Create"
                       class="btn btn-success btn-lg px-4">

                        <i class="bi bi-file-earmark-plus-fill me-2"></i>

                        Create Contract

                    </a>

                    <a asp-controller="ServiceRequests"
                       asp-action="Create"
                       class="btn btn-warning btn-lg px-4">

                        <i class="bi bi-headset me-2"></i>

                        New Request

                    </a>

                </div>

            </div>

            <!-- RIGHT -->

            <div class="col-lg-4 text-center mt-5 mt-lg-0">

                <div class="rounded-circle d-inline-flex align-items-center justify-content-center"
                     style="width:180px;
                            height:180px;
                            background:linear-gradient(135deg,#436436,#420217);
                            color:white;">

                    <div>

                        <i class="bi bi-bar-chart-line-fill display-3"></i>

                        <div class="fw-bold mt-2">

                            Dashboard Analytics

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- ================================================= -->
<!-- STATISTICS -->
<!-- ================================================= -->

<div class="row g-4 mb-5">

    <!-- CLIENTS -->

    <div class="col-xl-3 col-md-6">

        <div class="card dashboard-card shadow border-0 h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>

                        <div class="text-muted fw-semibold">

                            Total Clients

                        </div>

                        <h1 class="fw-bold mb-0">

                            @ViewBag.TotalClients

                        </h1>

                    </div>

                    <div class="rounded-4 p-3"
                         style="background-color:#436436; color:white;">

                        <i class="bi bi-people-fill fs-1"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- CONTRACTS -->

    <div class="col-xl-3 col-md-6">

        <div class="card dashboard-card shadow border-0 h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>

                        <div class="text-muted fw-semibold">

                            Contracts

                        </div>

                        <h1 class="fw-bold mb-0">

                            @ViewBag.TotalContracts

                        </h1>

                    </div>

                    <div class="rounded-4 p-3"
                         style="background-color:#D2FF28; color:black;">

                        <i class="bi bi-file-earmark-text-fill fs-1"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ACTIVE -->

    <div class="col-xl-3 col-md-6">

        <div class="card dashboard-card shadow border-0 h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>

                        <div class="text-muted fw-semibold">

                            Active Contracts

                        </div>

                        <h1 class="fw-bold mb-0">

                            @ViewBag.ActiveContracts

                        </h1>

                    </div>

                    <div class="rounded-4 p-3"
                         style="background-color:#C84C09; color:white;">

                        <i class="bi bi-check-circle-fill fs-1"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- REQUESTS -->

    <div class="col-xl-3 col-md-6">

        <div class="card dashboard-card shadow border-0 h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>

                        <div class="text-muted fw-semibold">

                            Service Requests

                        </div>

                        <h1 class="fw-bold mb-0">

                            @ViewBag.TotalRequests

                        </h1>

                    </div>

                    <div class="rounded-4 p-3"
                         style="background-color:#420217; color:white;">

                        <i class="bi bi-headset fs-1"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>