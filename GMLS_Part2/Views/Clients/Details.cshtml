@model GMLS_Part2.Models.Client

@{
    ViewData["Title"] = "Client Details";
}

<div class="container">

    <div class="card shadow-lg border-0">

        <!-- HEADER -->

        <div class="card-header bg-info text-white">

            <h3 class="mb-0">
                Client Details
            </h3>

        </div>

        <!-- BODY -->

        <div class="card-body">

            <dl class="row">

                <!-- CLIENT NAME -->

                <dt class="col-sm-3 fw-bold">
                    Client Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <!-- CONTACT DETAILS -->

                <dt class="col-sm-3 fw-bold">
                    Contact Details
                </dt>

                <dd class="col-sm-9">
                    @Model.ContactDetails
                </dd>

                <!-- REGION -->

                <dt class="col-sm-3 fw-bold">
                    Region
                </dt>

                <dd class="col-sm-9">
                    @Model.Region
                </dd>

            </dl>

            <!-- BUTTONS -->

            <div class="mt-4 d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model?.Id"
                   class="btn btn-warning">
                    Edit
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to List
                </a>

            </div>

        </div>

    </div>

</div>