@model GMLS_Part2.Models.Client

@{
    ViewData["Title"] = "Delete Client";
}

<div class="container">

    <div class="card shadow-lg border-0">

        <!-- HEADER -->

        <div class="card-header bg-danger text-white">

            <h3 class="mb-0">
                Delete Client
            </h3>

        </div>

        <!-- BODY -->

        <div class="card-body">

            <div class="alert alert-warning">

                <strong>
                    Warning:
                </strong>

                Are you sure you want to delete this client?

            </div>

            <dl class="row">

                <!-- CLIENT NAME -->

                <dt class="col-sm-3 fw-bold">
                    Client Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <!-- CONTACT DETAILS -->

                <dt class="col-sm-3 fw-bold">
                    Contact Details
                </dt>

                <dd class="col-sm-9">
                    @Model.ContactDetails
                </dd>

                <!-- REGION -->

                <dt class="col-sm-3 fw-bold">
                    Region
                </dt>

                <dd class="col-sm-9">
                    @Model.Region
                </dd>

            </dl>

            <!-- BUTTONS -->

            <form asp-action="Delete"
                  class="mt-4">

                <input type="hidden"
                       asp-for="Id" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">
                        Delete Client
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back to List
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>