@model GMLS_Part2.Models.Client

@{
    ViewData["Title"] = "Create Client";
}

<div class="container">

    <div class="card shadow-lg border-0">

        <!-- HEADER -->

        <div class="card-header bg-primary text-white">

            <h3 class="mb-0">
                Create Client
            </h3>

        </div>

        <!-- BODY -->

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- CLIENT NAME -->

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter client name..." />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <!-- CONTACT DETAILS -->

                <div class="mb-3">

                    <label asp-for="ContactDetails"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="ContactDetails"
                           class="form-control"
                           placeholder="Enter phone or email..." />

                    <span asp-validation-for="ContactDetails"
                          class="text-danger">
                    </span>

                </div>

                <!-- REGION -->

                <div class="mb-4">

                    <label asp-for="Region"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="Region"
                           class="form-control"
                           placeholder="Enter client region..." />

                    <span asp-validation-for="Region"
                          class="text-danger">
                    </span>

                </div>

                <!-- BUTTONS -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Client
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back to List
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}