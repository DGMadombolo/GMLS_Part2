@model IEnumerable<GMLS_Part2.Models.Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="fw-bold">
        Clients
    </h1>

    <a asp-action="Create"
       class="btn btn-primary">
        + Create Client
    </a>

</div>

<!-- ===================================================== -->
<!-- SEARCH / FILTER -->
<!-- ===================================================== -->

<form method="get"
      class="row g-3 mb-4">

    <!-- SEARCH CLIENT -->

    <div class="col-md-5">

        <label class="form-label fw-bold">
            Search Client
        </label>

        <input type="text"
               name="searchTerm"
               class="form-control"
               placeholder="Search by client name..." />

    </div>

    <!-- REGION -->

    <div class="col-md-5">

        <label class="form-label fw-bold">
            Region
        </label>

        <input type="text"
               name="region"
               class="form-control"
               placeholder="Search by region..." />

    </div>

    <!-- BUTTON -->

    <div class="col-md-2 d-flex align-items-end">

        <button type="submit"
                class="btn btn-dark w-100">
            Search
        </button>

    </div>

</form>

<!-- ===================================================== -->
<!-- CLIENT TABLE -->
<!-- ===================================================== -->

<table class="table table-bordered table-hover shadow-sm">

    <thead class="table-dark">

        <tr>

            <th>
                Client Name
            </th>

            <th>
                Contact Details
            </th>

            <th>
                Region
            </th>

            <th class="text-center">
                Actions
            </th>

        </tr>

    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>

                    <!-- NAME -->

                    <td>
                        @item.Name
                    </td>

                    <!-- CONTACT -->

                    <td>
                        @item.ContactDetails
                    </td>

                    <!-- REGION -->

                    <td>
                        @item.Region
                    </td>

                    <!-- ACTIONS -->

                    <td class="text-center">

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-info text-white">
                            Details
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>

                <td colspan="4"
                    class="text-center text-muted">

                    No clients found.

                </td>

            </tr>
        }

    </tbody>

</table>